# -----------------------------------------------------------
# 필수 제외 항목
# -----------------------------------------------------------

# Node 모듈 폴더 (매우 크고, 'npm install'로 다시 설치 가능)
/node_modules

# 빌드 출력 폴더 (배포용으로 생성되는 파일들)
/dist
/build 
/out

# -----------------------------------------------------------
# 환경 설정 및 로컬 개발 관련 제외 항목
# -----------------------------------------------------------

# 로컬 환경 설정 파일 (API Key 등 민감 정보 포함 가능)
# .env 파일은 Git에 올리지 않고, 환경 변수로 관리해야 합니다.
.env
.env.*
!.env.example # 템플릿 파일은 포함하여, 어떤 변수가 필요한지 알려줄 수 있음

# npm/yarn/pnpm 캐시 파일
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pnpm-lock.yaml

# OS가 생성하는 시스템 파일
.DS_Store # macOS
Thumbs.db # Windows

# -----------------------------------------------------------
# IDE 및 에디터 설정 (VS Code)
# -----------------------------------------------------------

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history # VS Code의 Local History 확장 사용 시
CLAUDE.md
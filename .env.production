# ============================================================
# DummyTalk FE — 프로덕션 환경변수
# ============================================================
# [커밋 정책] 이 파일은 Git에 커밋됩니다.
#   - VITE_API_URL은 공개 도메인이므로 노출 무방
#   - 절대 비밀키(Secret Key, DB 비밀번호 등)를 이 파일에 추가하지 마세요
#   - 민감한 값은 Vercel 대시보드 > Settings > Environment Variables에 등록
#
# [동작 방식] Vite 빌드 시 이 파일의 값이 번들에 포함됩니다.
#   Vercel 대시보드에 같은 키가 있으면 대시보드 값이 우선 적용됩니다.
# ============================================================


# ── 프로덕션 API 서버 (BE 배포 서버) ──────────────────────────
# HTTPS 전용. Vercel(dummytalk.vercel.app) ↔ BE(ddotg.dev) 통신
VITE_API_URL=https://ddotg.dev

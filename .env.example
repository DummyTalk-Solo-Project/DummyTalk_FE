# ============================================================
# DummyTalk FE — 환경변수 가이드 (Git 추적 대상, 실제 값 없음)
# ============================================================
#
# 관리 파일 2개:
#
#   .env.local       — 로컬 개발용 (Git 무시, 직접 수정)
#   .env.production  — Vercel 배포용 (Git 추적, 직접 수정)
#
# ============================================================


# ── .env.local (로컬 개발용) ──────────────────────────────────
#
# vite dev 서버 프록시 대상 주소.
# 설정하지 않으면 기본값 https://ddotg.dev 로 프록시됩니다.
#
# 로컬 BE 실행 중:
#   VITE_DEV_API_URL=http://localhost:8080
#
# 배포 BE 서버 사용:
#   VITE_DEV_API_URL=https://ddotg.dev


# ── .env.production (Vercel 배포용) ──────────────────────────
#
# Vercel 프로덕션 빌드 시 번들에 포함되는 API 주소.
# Vercel 대시보드 > Settings > Environment Variables에 같은 키를
# 등록하면 대시보드 값이 우선 적용됩니다.
#
# VITE_API_URL=https://ddotg.dev

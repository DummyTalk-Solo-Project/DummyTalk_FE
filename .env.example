# ============================================================
# DummyTalk FE — 환경변수 가이드 (버전 관리 대상, 실제 값 없음)
# ============================================================
#
# [사용 방법]
#   로컬 개발 : 이 파일을 복사해 .env.local 생성 후 값 입력
#   Vercel 배포: Vercel 대시보드 > Settings > Environment Variables에 등록
#
# [주의사항]
#   - .env.local, .env.production.local 등 실제 값이 있는 파일은 절대 커밋 금지
#   - VITE_ 접두사 변수는 빌드 시 번들에 포함 → 민감한 비밀키(Secret) 사용 불가
#   - 이 파일(.env.example)만 Git에 커밋 가능한 유일한 env 파일
#
# ============================================================


# ── [필수] 프로덕션 API 서버 Base URL ─────────────────────────
#
# Vercel 배포 시 대시보드에 이 값을 등록해야 합니다.
# trailing slash(/) 없이 도메인만 입력합니다.
#
# BE 배포 서버: https://ddotg.dev (HTTPS 전용, HTTP 불가)
# 로컬 개발 시에는 vite.config.ts 프록시가 자동 처리하므로 비워두세요.
#
VITE_API_URL=https://ddotg.dev


# ── [선택] 로컬 개발용 프록시 대상 서버 ─────────────────────────
#
# .env.local에만 사용합니다. Vercel 배포에는 영향 없습니다.
# 설정하지 않으면 vite.config.ts 기본값(https://ddotg.dev)이 사용됩니다.
#
# [케이스별 설정]
#   A. BE 서버를 로컬에서 직접 실행하는 경우
#      VITE_DEV_API_URL=http://localhost:8080
#
#   B. 배포된 BE 서버(ddotg.dev)를 로컬에서 바라볼 경우
#      VITE_DEV_API_URL=https://ddotg.dev    ← 기본값과 동일하므로 생략 가능
#
VITE_DEV_API_URL=
